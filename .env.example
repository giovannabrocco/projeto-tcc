# ---------- Banco ----------
DATABASE_URL=postgresql://docker:docker@localhost:5432/conectus

# ---------- API ----------
PORT=3333
# OBRIGATÓRIO em produção (string longa e aleatória)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRA_HORAS=8
CORS_ORIGIN=http://localhost:5173
# 1 quando estiver atrás de proxy/Nginx/Render/Railway (para o rate limit ver o IP real)
TRUST_PROXY=0
# usado nos links dos e-mails (redefinir senha) e como back_url padrão do checkout
FRONTEND_URL=http://localhost:5173

# ---------- Regras de assinatura ----------
TRIAL_DIAS=7
CARENCIA_DIAS=5

# ---------- Mercado Pago ----------
# Credenciais em https://www.mercadopago.com.br/developers/panel (use as de TESTE primeiro)
MP_ACCESS_TOKEN=
# "Assinatura secreta" gerada ao cadastrar o webhook no painel do MP
MP_WEBHOOK_SECRET=
# URL pública da API + /api/pagamentos/webhook (em dev use ngrok/cloudflared)
MP_NOTIFICATION_URL=
# para onde o MP devolve o cliente após pagar (padrão: FRONTEND_URL/assinatura/retorno)
MP_BACK_URL=

# ---------- E-mail (sem SMTP_HOST os e-mails aparecem só no log do servidor) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Conectus <nao-responda@conectus.app>"

# ---------- Painel interno da plataforma (cupons / lista de igrejas) ----------
PLATAFORMA_ADMIN_KEY=
